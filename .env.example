# ReviewMe — configuration (copier en .env, NE JAMAIS committer .env).
# Le .env réel est ignoré par .gitignore. Les secrets viennent UNIQUEMENT de l'environnement.

# --- GitHub (obligatoire) ---
# PAT fine-grained recommandé : 1 seul repo, permission "Pull requests: Read and write".
# NE PAS utiliser un PAT classic `repo` (accès total à tous les repos privés).
# (Le resolve de thread — v2 — pourrait exiger "Contents: R/W" ; à vérifier au déploiement.)
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=owner/repo

# --- Déclenchement ---
REVIEW_LABEL=review-me          # PR à reviewer (mode label)
REVIEW_ALL_PRS=false            # true = toute PR ouverte (ignore le label) — attention au coût
POLL_INTERVAL=300               # secondes entre deux polls (mode poll)

# --- Moteur de review ---
FETCH_BASE_TIMEOUT=30           # fetch best-effort de la branche de base ; 0 = desactive
REPO_PATH=.                     # clone local du repo cible (contexte de l'agent)
MAX_BUDGET_USD=10.0             # plafond de coût par review
CONFIDENCE_THRESHOLD=80         # findings sous ce seuil non postés
REVIEWER_ID=tech                # identité du reviewer dans le marqueur de dédup (ADR v3 D3).
                                # STABLE : le renommer reposte tous les commentaires en double.

# --- Reviewers multiples (ADR v3) ---
REVIEWME_CONFIG_HOME=           # dépôt de config EXTERNE (ex. ~/dev/mon-instance).
                                # Vide = config/projects/ du repo. Évite de forker le moteur.
PROJECT=                        # dossier <projets>/<nom>. Vide = mode simple (un seul reviewer)
MAX_COMMENTS_PER_PR=10          # plafond par PR, TOUS reviewers confondus (anti-noyade)

# --- GitHub App (identité dédiée, optionnel : sinon GITHUB_TOKEN) ---
GITHUB_APP_ID=                  # identifiant numérique de l'App
GITHUB_APP_PRIVATE_KEY_PATH=    # chemin du .pem (JAMAIS la clé en clair ici)
GITHUB_APP_INSTALLATION_ID=     # optionnel : résolu depuis le repo si absent

# --- Jira (contexte du reviewer `us`, optionnel : absent = reviewer skippé) ---
JIRA_BASE_URL=                  # ex. https://votre-org.atlassian.net
JIRA_EMAIL=                     # compte du token (auth Basic)
JIRA_API_TOKEN=                 # token API Atlassian
JIRA_AC_FIELD=customfield_10037 # champ des critères d'acceptation (varie selon l'instance)
JIRA_KEY_PREFIX=                # optionnel : restreint à un projet Jira (ex. ECOM)
CLAUDE_AGENT=                   # vide = persona du reviewer ; sinon un agent Claude Code
CLAUDE_BIN=                     # vide = `claude` du PATH ; sinon un wrapper compatible
CLAUDE_MODEL=                   # vide = modèle par défaut de la CLI ; sinon ex. claude-opus-4-8
BOT_LOGIN=                      # login du bot si identité dédiée (sinon dédup par marqueur)
LOGIN_SUFFIX_STRIP=            # retire un suffixe d'org des logins affichés (ex. -acme). Vide = tel quel
DRY_RUN=false                   # true = ne poste rien, log seulement

# --- Moteur LLM (session non interactive : VPS / CI) ---
# ANTHROPIC_API_KEY=sk-ant-xxx          # API Anthropic directe
#
# Passerelle interne (proxy d'entreprise compatible Anthropic) : rien à coder, ces
# variables sont héritées par `claude -p` depuis ce fichier.
# ANTHROPIC_BASE_URL=https://passerelle.interne/v1
# ANTHROPIC_AUTH_TOKEN=...              # si la passerelle a sa propre auth
# CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1   # certains proxies rejettent les en-têtes de
#                                            # prompt caching

# --- Webhook (mode webhook uniquement) ---
# WEBHOOK_SECRET=...            # OBLIGATOIRE pour démarrer le webhook (HMAC) — fail-closed sinon
# WEBHOOK_HOST=127.0.0.1        # exposer via reverse-proxy TLS, pas en direct
# WEBHOOK_PORT=8480
