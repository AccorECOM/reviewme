# ReviewMe — configuration (copy to .env, NEVER commit .env).
# The real .env is ignored by .gitignore. Secrets come ONLY from the environment.
#
# Comments sit on their own line: python-dotenv keeps an inline `# comment` after an
# empty value as the value itself. Optional keys are commented out; uncomment to set.

# =============================================================================
# 1. GitHub (required)
# =============================================================================
# Fine-grained PAT recommended: a single repo, permission "Pull requests: Read and write".
# DO NOT use a classic `repo` PAT (full access to every private repo).
# (Thread resolve — v2 — might require "Contents: R/W"; check at deployment.)
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=owner/repo

# GitHub App instead of a PAT (dedicated identity, optional). Requires `uv sync --extra github-app`.
# numeric App id
# GITHUB_APP_ID=
# path to the .pem (NEVER the key in clear text here)
# GITHUB_APP_PRIVATE_KEY_PATH=
# optional: resolved from the repo if absent
# GITHUB_APP_INSTALLATION_ID=

# =============================================================================
# 2. Triggering
# =============================================================================
# PRs to review (label mode)
REVIEW_LABEL=review-me
# true = every open PR (ignores the label) — watch the cost
REVIEW_ALL_PRS=false
# seconds between two polls (poll mode)
POLL_INTERVAL=300

# =============================================================================
# 3. Review engine
# =============================================================================
# local clone of the target repo (agent context)
REPO_PATH=.
# best-effort fetch of the base branch; 0 = disabled
FETCH_BASE_TIMEOUT=30
# cost cap PER REVIEWER and per review, in USD
MAX_BUDGET_USD=1.00
# findings below this threshold are not posted
CONFIDENCE_THRESHOLD=80
# cap per PR, ALL reviewers combined (anti-flooding)
MAX_COMMENTS_PER_PR=10
# true = posts nothing, logs only
DRY_RUN=false
# reviewer identity in the dedup marker (simple mode).
# STABLE: renaming it reposts every comment as a duplicate.
REVIEWER_ID=tech

# Optional engine settings (defaults shown).
# verification pass on the findings before posting; 0 = off
# REVIEWME_VERIFY=1
# lowest severity posted inline (the rest goes to the summary)
# REVIEWME_INLINE_MIN_SEVERITY=IMPORTANT
# language of the remarks (empty = per project.toml, else English)
# REVIEWME_LANGUAGE=
# extra base branches whose config is trusted (e.g. develop,release/*)
# REVIEWME_TRUSTED_BASES=
# where the project config is read: base (default) or pr
# REVIEWME_CONFIG_SOURCE=base
# 1 = baseline pipeline (no verify, dry-run) for comparisons
# REVIEWME_BASELINE=0

# =============================================================================
# 4. Multiple reviewers (per-project configuration)
# =============================================================================
# EXTERNAL config repo (e.g. ~/dev/my-instance). Empty = config/projects/ of this repo.
# REVIEWME_CONFIG_HOME=
# folder <projects>/<name>. Empty = simple mode (a single reviewer)
# PROJECT=

# =============================================================================
# 5. LLM engine (Claude Code CLI)
# =============================================================================
# empty = `claude` from PATH; otherwise a compatible wrapper
# CLAUDE_BIN=
# empty = the reviewer's persona; otherwise a Claude Code agent
# CLAUDE_AGENT=
# empty = the CLI's default model; otherwise e.g. claude-opus-4-8
# CLAUDE_MODEL=
# 1 = no LLM call, fabricated findings (CI tuning)
# REVIEWME_FAKE=0
# 1 = logs the CLI invocation and its JSON envelope
# REVIEWME_DEBUG=0

# Non-interactive session (VPS / CI): the CLI needs credentials.
# direct Anthropic API
# ANTHROPIC_API_KEY=sk-ant-xxx
#
# Anthropic-compatible gateway: nothing to code, these variables are inherited by `claude -p`.
# ANTHROPIC_BASE_URL=https://gateway.internal/v1
# if the gateway has its own auth
# ANTHROPIC_AUTH_TOKEN=...
# some proxies reject the prompt caching headers
# CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1

# =============================================================================
# 6. Jira (context for the `us` reviewer, optional: absent = reviewer skipped)
# =============================================================================
# e.g. https://your-org.atlassian.net
# JIRA_BASE_URL=
# account owning the token (Basic auth)
# JIRA_EMAIL=
# Atlassian API token
# JIRA_API_TOKEN=
# acceptance criteria field (find yours via /rest/api/3/field)
# JIRA_AC_FIELD=customfield_10037
# optional: restricts to one Jira project (e.g. SHOP)
# JIRA_KEY_PREFIX=

# =============================================================================
# 7. Identity and display
# =============================================================================
# bot login if dedicated identity (otherwise dedup by marker)
# BOT_LOGIN=
# strips an org suffix from displayed logins (e.g. -acme)
# LOGIN_SUFFIX_STRIP=

# =============================================================================
# 8. Ledger (findings and runs registry)
# =============================================================================
# where the ledger is written (default: data/ledger)
# REVIEWME_LEDGER_DIR=
# label of the run variant (default: derived from the mode)
# REVIEWME_LEDGER_VARIANT=
# 1 = store the text of the findings (overrides project.toml)
# REVIEWME_LEDGER_INCLUDE_TEXT=
# engine commit recorded in the runs (CI without .git)
# REVIEWME_ENGINE_COMMIT=

# =============================================================================
# 9. Webhook (webhook mode only)
# =============================================================================
# REQUIRED to start the webhook (HMAC) — fail-closed otherwise
# WEBHOOK_SECRET=
# expose through a TLS reverse proxy, not directly
# WEBHOOK_HOST=127.0.0.1
# WEBHOOK_PORT=8480

# =============================================================================
# 10. Dashboard (reviewme-web)
# =============================================================================
# first day of a known sprint
# REVIEWME_SPRINT_ANCHOR_DATE=2026-01-05
# its number
# REVIEWME_SPRINT_ANCHOR_NUM=1
# sprint length
# REVIEWME_SPRINT_LENGTH_DAYS=14
