# ReviewMe — configuration (copy to .env, NEVER commit .env).
# The real .env is ignored by .gitignore. Secrets come ONLY from the environment.

# --- GitHub (required) ---
# Fine-grained PAT recommended: a single repo, permission "Pull requests: Read and write".
# DO NOT use a classic `repo` PAT (full access to every private repo).
# (Thread resolve — v2 — might require "Contents: R/W"; check at deployment.)
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=owner/repo

# --- Triggering ---
REVIEW_LABEL=review-me          # PRs to review (label mode)
REVIEW_ALL_PRS=false            # true = every open PR (ignores the label) — watch the cost
POLL_INTERVAL=300               # seconds between two polls (poll mode)

# --- Review engine ---
FETCH_BASE_TIMEOUT=30           # best-effort fetch of the base branch; 0 = disabled
REPO_PATH=.                     # local clone of the target repo (agent context)
MAX_BUDGET_USD=10.0             # cost cap per review
CONFIDENCE_THRESHOLD=80         # findings below this threshold are not posted
REVIEWER_ID=tech                # reviewer identity in the dedup marker (ADR v3 D3).
                                # STABLE: renaming it reposts every comment as a duplicate.

# --- Multiple reviewers (ADR v3) ---
REVIEWME_CONFIG_HOME=           # EXTERNAL config repo (e.g. ~/dev/my-instance).
                                # Empty = config/projects/ of the repo. Avoids forking the engine.
PROJECT=                        # folder <projects>/<name>. Empty = simple mode (a single reviewer)
MAX_COMMENTS_PER_PR=10          # cap per PR, ALL reviewers combined (anti-flooding)

# --- GitHub App (dedicated identity, optional: otherwise GITHUB_TOKEN) ---
GITHUB_APP_ID=                  # numeric App id
GITHUB_APP_PRIVATE_KEY_PATH=    # path to the .pem (NEVER the key in clear text here)
GITHUB_APP_INSTALLATION_ID=     # optional: resolved from the repo if absent

# --- Jira (context for the `us` reviewer, optional: absent = reviewer skipped) ---
JIRA_BASE_URL=                  # e.g. https://your-org.atlassian.net
JIRA_EMAIL=                     # account owning the token (Basic auth)
JIRA_API_TOKEN=                 # Atlassian API token
JIRA_AC_FIELD=customfield_10037 # acceptance criteria field (varies by instance)
JIRA_KEY_PREFIX=                # optional: restricts to one Jira project (e.g. SHOP)
CLAUDE_AGENT=                   # empty = the reviewer's persona; otherwise a Claude Code agent
CLAUDE_BIN=                     # empty = `claude` from PATH; otherwise a compatible wrapper
REVIEWME_FAKE=                  # 1 = no LLM call, fabricated findings (CI tuning)
REVIEWME_DEBUG=                 # 1 = logs the CLI invocation and its JSON envelope
CLAUDE_MODEL=                   # empty = the CLI's default model; otherwise e.g. claude-opus-4-8
BOT_LOGIN=                      # bot login if dedicated identity (otherwise dedup by marker)
LOGIN_SUFFIX_STRIP=            # strips an org suffix from displayed logins (e.g. -acme). Empty = as is
DRY_RUN=false                   # true = posts nothing, logs only

# --- LLM engine (non-interactive session: VPS / CI) ---
# ANTHROPIC_API_KEY=sk-ant-xxx          # direct Anthropic API
#
# Internal gateway (Anthropic-compatible corporate proxy): nothing to code, these
# variables are inherited by `claude -p` from this file.
# ANTHROPIC_BASE_URL=https://gateway.internal/v1
# ANTHROPIC_AUTH_TOKEN=...              # if the gateway has its own auth
# CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1   # some proxies reject the
#                                            # prompt caching headers

# --- Webhook (webhook mode only) ---
# WEBHOOK_SECRET=...            # REQUIRED to start the webhook (HMAC) — fail-closed otherwise
# WEBHOOK_HOST=127.0.0.1        # expose through a TLS reverse proxy, not directly
# WEBHOOK_PORT=8480
